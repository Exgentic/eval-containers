# Protocol-preserving, model-pinning litellm gateway config.
#
# The `start` script renders ${MODEL_LIST} (flow-style YAML, one line) per mode,
# driven by the optional EVAL_MODEL_API (the wire API the target model is served
# over):
#   set   -> TRANSLATE: a single `*` entry rewrites to `${EVAL_MODEL_API}/${EVAL_MODEL}`
#            (or `${EVAL_MODEL_API}/*` to keep the client model), so every inbound
#            request is forwarded on that native API.
#   unset -> PASSTHROUGH: three family wildcards (claude-*/gemini-*/*) echo the
#            client's own model on its own native API.
# api_base per API is derived from OPENAI_API_BASE by the start script. Auth
# reuses OPENAI_API_KEY. No EVAL_API_* umbrella alias — see RULES rule 3.
model_list: ${MODEL_LIST}
litellm_settings:
  # otel -> gen_ai.* OTLP spans for the otelcol sidecar; eval_logger ->
  # /output/trajectory.jsonl + result.json for models/replay. Fires on every request.
  callbacks: ["otel", "eval_logger.eval_logger_instance"]
