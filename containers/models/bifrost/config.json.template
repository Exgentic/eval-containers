{
  "$schema": "https://www.getbifrost.ai/schema",
  "providers": {
    "anthropic": {
      "keys": [{ "name": "default", "value": "env.OPENAI_API_KEY", "models": ["*"], "weight": 1.0 }],
      "network_config": { "base_url": "${OPENAI_API_BASE}", "allow_private_network": true, "max_retries": 5, "retry_backoff_initial": 500, "retry_backoff_max": 15000 }
    },
    "openai": {
      "keys": [{ "name": "default", "value": "env.OPENAI_API_KEY", "models": ["*"], "weight": 1.0 }],
      "network_config": { "base_url": "${OPENAI_API_BASE}", "allow_private_network": true, "max_retries": 5, "retry_backoff_initial": 500, "retry_backoff_max": 15000 }
    },
    "gemini": {
      "keys": [{ "name": "default", "value": "env.OPENAI_API_KEY", "models": ["*"], "weight": 1.0 }],
      "network_config": { "base_url": "${OPENAI_API_BASE}/v1beta", "allow_private_network": true, "max_retries": 5, "retry_backoff_initial": 500, "retry_backoff_max": 15000 }
    }
  },
  ${GOVERNANCE}
  "plugins": [
    {
      "enabled": true,
      "name": "otel",
      "config": {
        "service_name": "dock-gateway",
        "collector_url": "${OTEL_COLLECTOR_URL}",
        "trace_type": "genai_extension",
        "protocol": "http"
      }
    }
  ],
  "framework": {
    "pricing": {
      "pricing_url": "file:///opt/gateway/data/pricing.json",
      "model_parameters_url": "file:///opt/gateway/data/model-parameters.json",
      "mcp_library_url": "file:///opt/gateway/data/mcp-library.json",
      "pricing_sync_interval": 86400,
      "mcp_library_sync_interval": 86400
    }
  }
}
