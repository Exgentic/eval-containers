#!/bin/bash
# Eval entrypoint — preps env/dirs/output, then drives the three-phase eval
# (agent → verifier → result, benchmarks/RULES.md rule 12).
#
# Two execution paths, selected by whether the caller pre-set ANTHROPIC_BASE_URL:
#
#   set (compose / k8s "runner" mode)  → the lean eval base.
#       otelcol + gateway are sibling containers/pods the orchestrator already
#       started and health-gated. The edge runs HERE, in front of the gateway,
#       so the agent's calls are recorded verbatim; the three phases then run as
#       a plain shell sequence — no process-compose.
#
#   unset (single-container mode)      → the -standalone bundle.
#       otelcol + gateway run in-process, so process-compose brings up all five
#       units (otelcol → gateway → agent → verifier → result) with readiness
#       gating. process-compose + /etc/process-compose.yaml ship ONLY in the
#       bundle (core/standalone.Dockerfile); the lean base has neither.
#
# Same agent/verifier/result semantics in both paths; the agent launch itself is
# shared via /usr/local/bin/run-agent so rule 7's env allow-list has one home.
#
# Env-var contract (set by /entrypoint.sh wrapper / the orchestrator):
#   TASK              agent's task prompt
#   EXPECTED_ANSWER   verifier's ground truth (NOT visible to agent)
#   TASK_ID           task identifier (verifier/result only — never the agent)
#   BENCHMARK         benchmark name (for result.json)
#   AGENT             agent name (for result.json)
#   MODEL             model name (for result.json)
#   TIMEOUT           agent wall-clock timeout in seconds
#   OPENAI_API_KEY    read by the in-container gateway in single-container mode
set -euo pipefail

# Resolve from the EVAL_* canonical axis first (what the CLI sets in container
# mode), falling back to the bare legacy names (set by compose/k8s), then a
# default. run-agent reads these from the env it inherits.
export TIMEOUT="${TIMEOUT:-${EVAL_TIMEOUT:-300}}"
export TASK_ID="${TASK_ID:-${EVAL_TASK_ID:-}}"
export MODEL="${MODEL:-${EVAL_MODEL:-}}"
export BENCHMARK="${BENCHMARK:-${EVAL_BENCHMARK:-unknown}}"
export AGENT="${AGENT:-${EVAL_AGENT:-unknown}}"
export TASK="${TASK:-}"
# When the benchmark declares internet=false, tell the agent explicitly rather
# than letting it infer network trouble from failed/absent tool calls — without
# this an agent that hits no internet can spend turns diagnosing or "fixing"
# connectivity instead of just solving the task (agents/RULES.md 22). This note
# is not the isolation boundary: benchmarks/RULES.md rule 9's network isolation
# blocks raw internet access (including WebFetch-style calls) for every
# benchmark unconditionally. EVAL_INTERNET additionally removes the agent's
# own web-search/fetch tools, for agents that support it (run-agent warns,
# doesn't fail, for the rest — agents/RULES.md 20): for WebFetch this just
# avoids a call bound to fail; for the LLM provider's own server-side
# web-search, which no network policy can reach, it's the one real (if
# temporary) mitigation this mechanism provides — agents/RULES.md 21.
if [ "${EVAL_INTERNET:-}" = "false" ]; then
  TASK="$TASK

No internet connection is required for this task. Do not try to access the internet in any way."
  export TASK
fi
# Defensive fallback (agent uid baked into image at build time).
id agent &>/dev/null || useradd -m -s /bin/bash -u 1002 agent

# ─── Output lifecycle (.agents/output/RULES.md) ──────────────────────
# /output is this task's directory. The launcher's own records live in agent/:
# config.env (rule 16), .lock (rule 32) and result.json's `error` (rule 17).
mkdir -p /output/{model,agent,task} /logs/verifier
# One awk, not two greps: with `pipefail` a grep that matches nothing fails the
# whole assignment, and a run launched with no EVAL_* at all is empty, not broken.
config=$(env | awk '/^EVAL_/ && !/^EVAL_(OUTPUT_DIR|RUN_ID|FORCE)=/' | LC_ALL=C sort)
if [ -f /output/agent/config.env ] && [ "$config" != "$(cat /output/agent/config.env)" ]; then
  echo "run: /output holds a run with a different configuration — use a new EVAL_RUN_ID (rule 23):" >&2
  diff /output/agent/config.env <(printf '%s\n' "$config") >&2 || true
  exit 3
fi
complete=false
if [ -s /output/task/result.json ] && [ -f /output/agent/result.json ] \
   && grep -q '"error":null' /output/agent/result.json; then
  complete=true
fi
if [ "$complete" = true ] && [ -z "${EVAL_FORCE:-}" ]; then
  echo "run: complete, not rerun (rule 26): $(cat /output/task/result.json)"
  exit 0
fi

# Claim the directory before touching anything in it (rule 32). `set -C` makes
# the create O_EXCL, so two launchers racing here cannot both win; a claim whose
# holder stopped refreshing it is a dead attempt's, and is taken over.
if ! (set -C; : > /output/agent/.lock) 2>/dev/null; then
  if [ -n "$(find /output/agent -maxdepth 1 -name .lock -mmin -2)" ]; then
    echo "run: another attempt is in progress in /output — agent/.lock touched under 2 min ago (rule 32)" >&2
    exit 3
  fi
  : > /output/agent/.lock
fi
# Release the claim whenever this shell exits, or a launcher that dies before the
# pipeline starts (an edge that never came up) would refuse its own next attempt.
# The three phases `exec` past this trap on purpose: from there the claim is
# write-result's to release, and a container killed outright leaves one that
# nothing refreshes, so it goes stale on its own.
trap 'rm -f /output/agent/.lock' EXIT
( while sleep 30; do touch /output/agent/.lock; done ) &

# Failed or forced: empty the previous attempt (rules 28–30), keeping this
# attempt's own claim. otelcol holds model/traces.jsonl open, so that one is
# truncated rather than unlinked.
find /output -mindepth 1 -maxdepth 1 -type f -delete
find /output/{model,agent,task} -mindepth 1 \
  ! -path /output/model/traces.jsonl ! -name .lock -delete
if [ -f /output/model/traces.jsonl ]; then : > /output/model/traces.jsonl; fi
printf '%s\n' "$config" > /output/agent/config.env
chown -R agent:agent /output/agent /tmp 2>/dev/null || true
chmod 0755 /output /output/agent /output/task /output/model

# Capture run start time for the result writer.
date -u +%Y-%m-%dT%H:%M:%SZ > /output/agent/.started-at

# ─── Runner mode (lean base) ──────────────────────────────────────────
# External gateway iff ANTHROPIC_BASE_URL was set by the caller. The gateway +
# otelcol are siblings the orchestrator health-gated, so run the three phases
# directly. Each phase runs regardless of the previous one's exit status
# (process-compose's `process_completed` semantics): the verifier always grades
# whatever the agent produced — even on a timeout or crash — and a result.json
# is always written.
if [ -n "${ANTHROPIC_BASE_URL+set}" ]; then
  # The edge sits between the agent and the gateway: it pins the model and
  # records every call verbatim, including the tool definitions the gateway's
  # own traces summarise away (.agents/edge/RULES.md). One static binary, so it
  # needs no supervisor — start it, wait for its own probe, and point the agent
  # at it instead of at the gateway.
  # Scoped to the edge's own process: OPENAI_API_BASE is the *gateway's*
  # upstream everywhere else, and exporting it here would repoint whatever else
  # reads it.
  edge_upstream="${OPENAI_API_BASE:-$(printf '%s' "$ANTHROPIC_BASE_URL" | sed 's#/anthropic$##')}"
  # .zst: the edge holds one encoder open for the run, so it sees that each
  # request repeats the previous conversation — ~138x on a real trajectory,
  # against ~7x for anything that compresses each record alone.
  OPENAI_API_BASE="$edge_upstream" EDGE_UPSTREAM=gateway \
    OUT=/output/model/calls.jsonl.zst \
    /opt/edge/start >> /output/model/edge.log 2>&1 &
  edge_ready=0
  for _ in $(seq 1 60); do
    if /opt/edge/start health >/dev/null 2>&1; then edge_ready=1; break; fi
    sleep 0.5
  done
  if [ "$edge_ready" != 1 ]; then
    echo "edge did not become ready; see /output/model/edge.log" >&2
    tail -5 /output/model/edge.log >&2 || true
    exit 1
  fi
  export ANTHROPIC_BASE_URL="http://127.0.0.1:4100/anthropic"
  export OPENAI_BASE_URL="http://127.0.0.1:4100/openai/v1"
  export GOOGLE_GEMINI_BASE_URL="http://127.0.0.1:4100/genai"

  /usr/local/bin/run-agent || true
  bash /grade.sh || true
  exec /usr/local/bin/write-result
fi

# ─── Single-container mode (bundle) ───────────────────────────────────
# We own the whole pipeline. Point the agent + gateway at loopback and let
# process-compose bring up otelcol → gateway → agent → verifier → result.
# The edge fronts the in-process gateway here too, so a single-container run is
# recorded exactly like a compose one. Its upstream is set on the edge process
# in process-compose.yaml, NOT exported: OPENAI_API_BASE is the gateway's own
# upstream, and overwriting it would point the gateway at itself.
export ANTHROPIC_BASE_URL="http://127.0.0.1:4100/anthropic"
# OpenAI base needs /v1 (clients append /chat/completions); anthropic doesn't.
export OPENAI_BASE_URL="http://127.0.0.1:4100/openai/v1"
export GOOGLE_GEMINI_BASE_URL="http://127.0.0.1:4100/genai"
# litellm's OTel callback honors this env var; bifrost reads its collector_url
# from config.json. Setting it unconditionally is harmless for bifrost.
export OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT:-http://otelcol:4318}"

# The gateway config hardcodes the hostname `otelcol`; in-process there is no
# DNS, so map it to loopback (only when nothing else already resolves it).
if ! getent hosts otelcol >/dev/null 2>&1; then
  echo "127.0.0.1 otelcol" >> /etc/hosts
fi

exec /usr/local/bin/process-compose up \
  --config /etc/process-compose.yaml \
  --disable-dotenv \
  --tui=false
