#!/bin/bash
# Launch the agent under the eval's isolation contract. Shared by BOTH
# orchestration paths so the env allow-list has exactly one home:
#   - single-container bundle: process-compose.yaml's `agent` process runs this;
#   - compose/k8s lean base:   the runner sequence in /usr/local/bin/run runs this.
#
# Contract enforced here:
#   - non-root: `gosu agent` drops to the unprivileged agent uid (rule 13);
#   - bounded:  `timeout -k 30 $TIMEOUT` caps the agent's wall-clock (rule 14).
#     `-k 30` force-kills (SIGKILL) 30s after the initial SIGTERM if the agent
#     process ignores or outlives it — without it, an agent that doesn't die on
#     SIGTERM (observed with Node-based agents) keeps running past $TIMEOUT with
#     no enforced cutoff, producing a truncated/ambiguous trace instead of a
#     clean timeout;
#   - scrubbed: `env -i <allow-list>` hands the agent ONLY the problem text and
#     the gateway endpoints — never the task IDENTITY (TASK_ID). A model that
#     recognizes a benchmark instance id can recall a memorized solution and
#     inflate the score; the verifier/result steps read the id from the
#     inherited container env, so grading is unaffected (rule 7).
#
# Fail loud if EVAL_AGENT_REASONING_EFFORT is set but the agent's entrypoint
# doesn't reference it — a supported agent declares itself by using the var.
if [ -n "${EVAL_AGENT_REASONING_EFFORT:-}" ] && ! grep -q EVAL_AGENT_REASONING_EFFORT /run.sh; then
  echo "run-agent: EVAL_AGENT_REASONING_EFFORT is set but agent '${EVAL_AGENT:-?}' does not support it" >&2
  exit 2
fi

# Fail loud if EVAL_INTERNET=false (the benchmark's declared policy) but the
# agent's entrypoint doesn't reference it — an agent that cannot deny its own
# web tools is an invalid pairing for that benchmark, not a degraded one. This
# is not the isolation boundary (benchmarks rule 9 already blocks raw internet
# access unconditionally, on every surface, for every benchmark); it's about
# not silently leaving the agent's own LLM-provider-mediated web tools enabled
# — the one channel network isolation can't reach — on a benchmark that
# declared it doesn't want them.
if [ "${EVAL_INTERNET:-}" = "false" ] && ! grep -q EVAL_INTERNET /run.sh; then
  echo "run-agent: EVAL_INTERNET=false but agent '${EVAL_AGENT:-?}' cannot enforce it" >&2
  exit 2
fi

# stdout/stderr go straight to /output/agent/{stdout,stderr}.log (raw, not via
# process-compose's JSON log envelope, which breaks verifiers reading stdout).
# Every value is read from the inherited environment — exported by
# /usr/local/bin/run (single-container) or set by the orchestrator (compose/k8s).
#
# Not exec'd: record the exit status for write-result (rule 16). 124 = timeout.
rc=0
timeout -k 30 "${TIMEOUT:-300}" gosu agent env -i \
  PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin \
  HOME=/home/agent USER=agent LANG=C.UTF-8 \
  TASK="${TASK:-}" MODEL="${MODEL:-}" TIMEOUT="${TIMEOUT:-300}" \
  EVAL_AGENT_REASONING_EFFORT="${EVAL_AGENT_REASONING_EFFORT:-}" \
  EVAL_INTERNET="${EVAL_INTERNET:-}" \
  OPENAI_BASE_URL="${OPENAI_BASE_URL:-}" OPENAI_API_KEY=sk-proxy \
  ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL:-}" ANTHROPIC_API_KEY=sk-proxy \
  GOOGLE_GEMINI_BASE_URL="${GOOGLE_GEMINI_BASE_URL:-}" GEMINI_API_KEY=sk-proxy \
  /run.sh > /output/agent/stdout.log 2> /output/agent/stderr.log || rc=$?
printf '%s' "$rc" > /output/agent/.exit-code

# On a non-zero exit the agent's own diagnostics (upstream 4xx/5xx from the
# gateway, connection refused, auth rejections) sit only in stderr.log, and the
# verifier that runs next reports a downstream symptom ("answer file missing")
# that hides the real cause. Echo a short banner + the stderr tail to THIS
# process's stderr so the actual failure lands on the run's console/logs. Kept
# to a tail so a normal streaming-client disconnect doesn't dump the whole log;
# the full trace stays in /output/agent/stderr.log. rc 124 = timeout (rule 14).
if [ "$rc" -ne 0 ]; then
  {
    echo "run-agent: agent '${EVAL_AGENT:-?}' exited $rc$( [ "$rc" -eq 124 ] && echo ' (timeout)' ) — last stderr (full log: /output/agent/stderr.log):"
    tail -n 25 /output/agent/stderr.log 2>/dev/null | sed 's/^/  | /'
  } >&2
fi

exit "$rc"
