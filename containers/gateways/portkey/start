#!/bin/sh
# Start Caddy (:4000) + Portkey (:8787).
#
# Routes (set in Caddyfile):
#   /openai/*                    → portkey  (x-portkey-config model rewrite)
#   /anthropic/*  /genai/*       → 501 Not Implemented
#                                  (portkey self-hosted doesn't translate
#                                  these into upstream OpenAI Chat —
#                                  failing loud is honest)
#
# Env contract:
#   EVAL_MODEL        <provider>/<model> for the routing target.
#
# Upstream auth flows through whatever env var the chosen provider's
# SDK reads (OPENAI_API_KEY + OPENAI_API_BASE for OpenAI-compatible
# endpoints). Portkey receives the key + base via x-portkey-config and
# x-portkey-custom-host headers. The framework does NOT introduce a
# `EVAL_API_*` umbrella alias.

set -eu

# Private-CA upstream: when the deploy mounts an extra CA at /etc/eval-ca/ca.pem
# (see deploy/kind/README.md § 'Private-CA upstreams'), trust it IN ADDITION to
# the built-in roots. Node ignores SSL_CERT_FILE; NODE_EXTRA_CA_CERTS is the
# supported knob and APPENDS the file to the bundled roots (no public roots lost),
# so it takes the CA-only file directly. curl, by contrast, uses CURL_CA_BUNDLE as
# its whole trust store, so it gets a COMBINED bundle (public roots + the extra CA).
# Guard the read: if the system bundle is missing (e.g. a base-image change), fall
# back to CA-only for curl rather than letting `cat` abort the gateway under
# `set -eu`. No mount → unchanged, public-roots-only trust.
if [ -f /etc/eval-ca/ca.pem ]; then
  export NODE_EXTRA_CA_CERTS=/etc/eval-ca/ca.pem
  if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
    cat /etc/ssl/certs/ca-certificates.crt /etc/eval-ca/ca.pem > /tmp/ca-bundle.pem
  else
    echo "warn: /etc/ssl/certs/ca-certificates.crt missing — trusting the mounted CA only" >&2
    cat /etc/eval-ca/ca.pem > /tmp/ca-bundle.pem
  fi
  export CURL_CA_BUNDLE=/tmp/ca-bundle.pem
fi

: "${EVAL_MODEL:?EVAL_MODEL must be set to <provider>/<model>}"

case "$EVAL_MODEL" in
  */*)
    MODEL_NAME=${EVAL_MODEL#*/}
    ;;
  *)
    echo "EVAL_MODEL must be of form <provider>/<model> (got: $EVAL_MODEL)" >&2
    exit 2
    ;;
esac

# Portkey wants custom-host with /v1 suffix; it appends /chat/completions, etc.
case "${OPENAI_API_BASE:-}" in
  */v1|*/v1/) CUSTOM_HOST="${OPENAI_API_BASE%/}" ;;
  ?*)         CUSTOM_HOST="${OPENAI_API_BASE%/}/v1" ;;
  *)          CUSTOM_HOST="" ;;
esac

# x-portkey-config: full routing config (provider + api_key +
# override_params.model). Portkey requires one of {provider+api_key,
# strategy+targets, cache, retry} at the top level — the first form is
# simplest. override_params rewrites whatever model the agent sends
# to the configured upstream model.
PORTKEY_CONFIG=$(printf '{"provider":"openai","api_key":"%s","override_params":{"model":"%s"}}' \
  "${OPENAI_API_KEY:-}" "$MODEL_NAME")

export MODEL_NAME CUSTOM_HOST PORTKEY_CONFIG

# Caddy on $PORT (default 4000).
/opt/gateway/caddy run --config /opt/gateway/Caddyfile --adapter caddyfile &

# Portkey bound to 127.0.0.1:8787 (foreground; container PID 1).
cd /opt/gateway/portkey
exec node build/start-server.js
