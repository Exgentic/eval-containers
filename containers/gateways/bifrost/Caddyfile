# Stamp the inbound wire into X-Eval-Wire from the path prefix, then proxy to
# bifrost on :4001. bifrost's governance rules key on this header to pin on the
# incoming wire (its CEL can't see the request path). `header_up` REPLACES the
# field, so a client can't spoof it. Default (unprefixed) → openai, so an
# unexpected path still resolves a provider (fail-safe, not "provider not found").
{
	admin off
	log {
		output discard
	}
}

:4000 {
	@anthropic path /anthropic/*
	@genai path /genai/*
	handle @anthropic {
		reverse_proxy 127.0.0.1:4001 {
			header_up X-Eval-Wire anthropic
		}
	}
	handle @genai {
		reverse_proxy 127.0.0.1:4001 {
			header_up X-Eval-Wire gemini
		}
	}
	handle {
		reverse_proxy 127.0.0.1:4001 {
			header_up X-Eval-Wire openai
		}
	}
}
