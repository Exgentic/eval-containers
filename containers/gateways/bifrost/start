#!/bin/sh
# Start the bifrost gateway. Renders config.json from config.json.template.
#
# Modes, rendered into the governance block:
#   EVAL_MODEL_API set  -> WIRE OVERRIDE: force that wire, pin EVAL_MODEL if set.
#   else EVAL_MODEL set -> NATIVE PIN: pin on the inbound wire — nginx stamps
#                          X-Eval-Wire from the path, one rule per provider keys
#                          on it (bifrost governance can't see the path itself).
#   else                -> passthrough (client model + native routing).
#
# Env contract:
#   EVAL_MODEL      target model, a BARE handle (e.g. aws/claude-opus-4-8).
#   EVAL_MODEL_API  OPTIONAL wire override: anthropic | openai | gemini.
#   OPENAI_API_BASE upstream root; each provider appends its native path.
#   LOG_LEVEL       bifrost log level (default info).
# Upstream auth is the provider-native env var (OPENAI_API_KEY etc.) — no
# umbrella alias (gateways/RULES.md rule 3).

set -eu

TEMPLATE=/opt/gateway/data/config.json.template
CONFIG=/opt/gateway/data/config.json

if [ -f "$TEMPLATE" ]; then
  # Build the governance block: a single pin rule in translate mode, empty in
  # passthrough mode. JSON on one line so it substitutes as a single sed value.
  case "${EVAL_MODEL_API:-}" in
    ""|anthropic|openai|gemini) ;;
    *) echo "EVAL_MODEL_API must be anthropic|openai|gemini (got: $EVAL_MODEL_API)" >&2; exit 2 ;;
  esac

  if [ -n "${EVAL_MODEL_API:-}" ]; then
    # WIRE OVERRIDE: one cel="true" rule forces EVAL_MODEL_API; pin the model if set.
    if [ -n "${EVAL_MODEL:-}" ]; then MODEL=", \"model\": \"${EVAL_MODEL}\""; else MODEL=""; fi
    RULES="{ \"id\": \"pin\", \"name\": \"pin\", \"enabled\": true, \"scope\": \"global\", \"priority\": 1, \"cel_expression\": \"true\", \"targets\": [{ \"provider\": \"${EVAL_MODEL_API}\"${MODEL}, \"weight\": 1.0 }] }"
    GOVERNANCE="\"governance\": { \"routing_rules\": [${RULES}] },"
  elif [ -n "${EVAL_MODEL:-}" ]; then
    # NATIVE PIN: pin the model on the inbound wire. nginx stamps X-Eval-Wire from
    # the path; one rule per provider keys on it (mutually exclusive).
    RULES=""; pr=0
    for p in anthropic openai gemini; do
      pr=$((pr + 1))
      [ -n "$RULES" ] && RULES="$RULES, "
      RULES="$RULES{ \"id\": \"pin-$p\", \"name\": \"pin-$p\", \"enabled\": true, \"scope\": \"global\", \"priority\": $pr, \"cel_expression\": \"headers['x-eval-wire'] == '$p'\", \"targets\": [{ \"provider\": \"$p\", \"model\": \"${EVAL_MODEL}\", \"weight\": 1.0 }] }"
    done
    GOVERNANCE="\"governance\": { \"routing_rules\": [${RULES}] },"
  else
    GOVERNANCE=""
  fi

  : "${OTEL_EXPORTER_OTLP_ENDPOINT:=http://otelcol:4318}"
  OTEL_COLLECTOR_URL="${OTEL_EXPORTER_OTLP_ENDPOINT%/}/v1/traces"

  sed -e "s|\${GOVERNANCE}|${GOVERNANCE}|g" \
      -e "s|\${OPENAI_API_BASE}|${OPENAI_API_BASE-}|g" \
      -e "s|\${OTEL_COLLECTOR_URL}|${OTEL_COLLECTOR_URL}|g" \
      < "$TEMPLATE" > "$CONFIG"
fi

# nginx shim on :4000 stamps the inbound wire into X-Eval-Wire (see nginx.conf);
# bifrost listens on loopback :4001 behind it. The world reaches nginx.
nginx

exec /opt/gateway/main \
  -app-dir /opt/gateway/data \
  -port 4001 \
  -host 127.0.0.1 \
  -log-level "${LOG_LEVEL:-info}" \
  -log-style json
