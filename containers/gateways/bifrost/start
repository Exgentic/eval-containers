#!/bin/sh
# Start the bifrost gateway. Renders config.json from config.json.template.
#
# Modes, rendered into the governance block:
#   EVAL_MODEL_API set  -> WIRE OVERRIDE: force that wire, pin EVAL_MODEL if set.
#   else EVAL_MODEL set -> NATIVE PIN: pin on the inbound wire — caddy stamps
#                          X-Eval-Wire from the path, one rule per provider keys
#                          on it (bifrost governance can't see the path itself).
#   else                -> passthrough (client model + native routing).
#
# Env contract:
#   EVAL_MODEL      target model, a BARE handle (e.g. aws/claude-opus-4-8).
#   EVAL_MODEL_API  OPTIONAL wire override: anthropic | openai | gemini.
#   EVAL_INPUT_COST_PER_TOKEN, EVAL_OUTPUT_COST_PER_TOKEN
#                   OPTIONAL, both or neither: USD-per-token prices rendered
#                   as a global pricing override, for models bifrost's
#                   catalog doesn't know (e.g. a proxy's custom handles).
#   OPENAI_API_BASE upstream root; each provider appends its native path.
#   LOG_LEVEL       bifrost log level (default info).
# Upstream auth is the provider-native env var (OPENAI_API_KEY etc.) — no
# umbrella alias (gateways/RULES.md rule 3).

set -eu

# Private-CA upstream: when the deploy mounts an extra CA at /etc/eval-ca/ca.pem
# (see deploy/kind/README.md § 'Private-CA upstreams'), APPEND it to the system
# roots rather than replace them. Point the TLS knobs at a COMBINED bundle
# (public roots + the extra CA), never at the CA-only file: SSL_CERT_FILE and
# CURL_CA_BUNDLE set the whole trust store, so a CA-only file would drop every
# public root on the stacks that honour them. Concatenate into a writable file
# and point curl (health) + the Go runtime at that superset. Guard the read: if
# the system bundle is missing (e.g. a base-image change), fall back to CA-only
# rather than letting `cat` abort the gateway under `set -eu`. No mount →
# unchanged, public-roots-only trust.
if [ -f /etc/eval-ca/ca.pem ]; then
  if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
    cat /etc/ssl/certs/ca-certificates.crt /etc/eval-ca/ca.pem > /tmp/ca-bundle.pem
  else
    echo "warn: /etc/ssl/certs/ca-certificates.crt missing — trusting the mounted CA only" >&2
    cat /etc/eval-ca/ca.pem > /tmp/ca-bundle.pem
  fi
  export SSL_CERT_FILE=/tmp/ca-bundle.pem CURL_CA_BUNDLE=/tmp/ca-bundle.pem
fi

TEMPLATE=/opt/gateway/data/config.json.template
CONFIG=/opt/gateway/data/config.json

if [ -f "$TEMPLATE" ]; then
  # Build the governance block: a single pin rule in translate mode, empty in
  # passthrough mode. JSON on one line so it substitutes as a single sed value.
  case "${EVAL_MODEL_API:-}" in
    ""|anthropic|openai|gemini) ;;
    *) echo "EVAL_MODEL_API must be anthropic|openai|gemini (got: $EVAL_MODEL_API)" >&2; exit 2 ;;
  esac

  # Pin the model when EVAL_MODEL is set; omit to keep the client's model.
  if [ -n "${EVAL_MODEL:-}" ]; then MODEL=", \"model\": \"${EVAL_MODEL}\""; else MODEL=""; fi
  if [ -n "${EVAL_MODEL_API:-}" ]; then
    # WIRE OVERRIDE: one cel="true" rule forces EVAL_MODEL_API.
    RULES="{ \"id\": \"pin\", \"name\": \"pin\", \"enabled\": true, \"scope\": \"global\", \"priority\": 1, \"cel_expression\": \"true\", \"targets\": [{ \"provider\": \"${EVAL_MODEL_API}\"${MODEL}, \"weight\": 1.0 }] }"
  else
    # NATIVE ROUTING: name the provider per inbound wire (caddy stamps X-Eval-Wire
    # from the path). bifrost can't auto-resolve a provider from the model (bare or
    # `azure/…`-prefixed → "provider not found"), so a rule MUST name it.
    RULES=""; pr=0
    for p in anthropic openai gemini; do
      pr=$((pr + 1))
      [ -n "$RULES" ] && RULES="$RULES, "
      RULES="$RULES{ \"id\": \"pin-$p\", \"name\": \"pin-$p\", \"enabled\": true, \"scope\": \"global\", \"priority\": $pr, \"cel_expression\": \"headers['x-eval-wire'] == '$p'\", \"targets\": [{ \"provider\": \"$p\"${MODEL}, \"weight\": 1.0 }] }"
    done
  fi
  # Optional pricing: both vars render ONE wildcard pricing override so
  # bifrost costs models its catalog doesn't know. Neither set → no
  # override (config unchanged). Exactly one set → fail loud: half a
  # price would silently miscost every span.
  PRICING=""
  if [ -n "${EVAL_INPUT_COST_PER_TOKEN:-}${EVAL_OUTPUT_COST_PER_TOKEN:-}" ]; then
    if [ -z "${EVAL_INPUT_COST_PER_TOKEN:-}" ] || [ -z "${EVAL_OUTPUT_COST_PER_TOKEN:-}" ]; then
      echo "EVAL_INPUT_COST_PER_TOKEN and EVAL_OUTPUT_COST_PER_TOKEN must be set together" >&2
      exit 2
    fi
    # Numeric-only guard: these splice into JSON through sed, so this also
    # blocks sed/JSON metacharacters.
    case "${EVAL_INPUT_COST_PER_TOKEN}${EVAL_OUTPUT_COST_PER_TOKEN}" in
      *[!0-9.eE+-]*)
        echo "EVAL_*_COST_PER_TOKEN must be numeric USD per token" >&2
        exit 2
        ;;
    esac
    # pricing_patch is a JSON-encoded STRING; \\\\\" here → \\" after the
    # shell → \" in the file after sed's replacement collapses \\ to \.
    PRICING="\"pricing_overrides\": [{ \"id\": \"eval-price\", \"name\": \"eval-price\", \"scope_kind\": \"global\", \"match_type\": \"wildcard\", \"pattern\": \"*\", \"request_types\": [\"chat_completion\", \"responses\"], \"pricing_patch\": \"{\\\\\"input_cost_per_token\\\\\": ${EVAL_INPUT_COST_PER_TOKEN}, \\\\\"output_cost_per_token\\\\\": ${EVAL_OUTPUT_COST_PER_TOKEN}}\" }], "
  fi
  GOVERNANCE="\"governance\": { ${PRICING}\"routing_rules\": [${RULES}] },"

  : "${OTEL_EXPORTER_OTLP_ENDPOINT:=http://otelcol:4318}"
  OTEL_COLLECTOR_URL="${OTEL_EXPORTER_OTLP_ENDPOINT%/}/v1/traces"

  # bifrost's openai/anthropic provider clients append their own /v1/... path,
  # so network_config.base_url must be the bare root — but OPENAI_API_BASE
  # follows the OpenAI-SDK convention of already including /v1 (see
  # docs/guides/deploy-on-kubernetes.md). Strip it here so the template's
  # ${OPENAI_API_BASE} substitution lands on the root the client expects
  # (mirrors litellm/start's identical normalization).
  ROOT_API_BASE=${OPENAI_API_BASE:-}; ROOT_API_BASE=${ROOT_API_BASE%/}; ROOT_API_BASE=${ROOT_API_BASE%/v1}

  sed -e "s|\${GOVERNANCE}|${GOVERNANCE}|g" \
      -e "s|\${OPENAI_API_BASE}|${ROOT_API_BASE}|g" \
      -e "s|\${OTEL_COLLECTOR_URL}|${OTEL_COLLECTOR_URL}|g" \
      < "$TEMPLATE" > "$CONFIG"
fi

# caddy shim on :4000 stamps the inbound wire into X-Eval-Wire (see Caddyfile);
# bifrost listens on loopback :4001 behind it. The world reaches caddy.
/opt/gateway/caddy run --config /opt/gateway/Caddyfile --adapter caddyfile &

exec /opt/gateway/main \
  -app-dir /opt/gateway/data \
  -port 4001 \
  -host 127.0.0.1 \
  -log-level "${LOG_LEVEL:-info}" \
  -log-style json
